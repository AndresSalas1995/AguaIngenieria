@model DataModels.Novedade

@{
    ViewBag.Title = "Eliminar Novedad";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="w-100" style="max-width: 600px;">
        <div class="text-center mb-4">
            <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo" style="height: 70px; margin-bottom: 10px;" />
            <h2 class="text-danger fw-bold mb-2">¿Eliminar novedad?</h2>
            <span class="d-block mx-auto" style="width: 120px; height: 3px; background-color: #dc3545; border-radius: 2px;"></span>
        </div>
        <div class="alert alert-warning text-center">
            <strong>¿Estás seguro que deseas eliminar la siguiente novedad?</strong>
        </div>
        <dl class="row justify-content-center">
            <dt class="col-sm-4 text-end">Título</dt>
            <dd class="col-sm-8 text-start">@Model.Titulo</dd>
            <dt class="col-sm-4 text-end">Fuente</dt>
            <dd class="col-sm-8 text-start">@Model.Fuente</dd>
            <dt class="col-sm-4 text-end">Fecha</dt>
            <dd class="col-sm-8 text-start">@Model.Fecha.ToString("dd 'de' MMMM yyyy")</dd>
            <dt class="col-sm-4 text-end">Resumen</dt>
            <dd class="col-sm-8 text-start">@Model.Resumen</dd>
        </dl>
        @using (Html.BeginForm("Eliminar", "NovedadesAdmin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <div class="d-flex justify-content-center mt-4">
                <button type="submit" class="btn btn-danger me-2">
                    <i class="fas fa-trash"></i> Confirmar eliminación
                </button>
                <a href="@Url.Action("NovedadesCRUD", "NovedadesAdmin")" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        }
    </div>
</div>

