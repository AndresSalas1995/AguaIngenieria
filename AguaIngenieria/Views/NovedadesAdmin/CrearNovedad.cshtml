@model DataModels.Novedade

@{
    ViewBag.Title = "Crear Novedad";
}

<div class="d-flex justify-content-center py-5 bg-light" style="min-height: 100vh;">
    <div class="card shadow-lg p-4 rounded" style="max-width: 450px; width: 100%;">
        <div class="text-center mb-4">
            @* Logo del sitio *@
            <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo" style="width: 100px; height: auto;" class="mb-3" />
            <h3 class="text-primary fw-bold">Crear Nueva Novedad</h3>
            <p class="text-muted mb-0">Rellena los campos para agregar una nueva novedad</p>
        </div>

        @using (Html.BeginForm("CrearNovedad", "NovedadesAdmin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Titulo, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Título de la novedad", required = "required" })
                @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Fuente, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.Fuente, new { @class = "form-control", placeholder = "Fuente (opcional)" })
                @Html.ValidationMessageFor(m => m.Fuente, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Fecha, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Resumen, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(m => m.Resumen, new { @class = "form-control", rows = 4, placeholder = "Resumen de la novedad" })
                @Html.ValidationMessageFor(m => m.Resumen, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.UrlNoticia, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.UrlNoticia, new { @class = "form-control", placeholder = "URL de la noticia (opcional)" })
                @Html.ValidationMessageFor(m => m.UrlNoticia, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Tipo de Imagen</label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TipoImagen" id="imgPredef" value="predefinida" checked>
                    <label class="form-check-label" for="imgPredef">Usar imagen predefinida</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TipoImagen" id="imgCustom" value="personalizada">
                    <label class="form-check-label" for="imgCustom">Subir imagen personalizada</label>
                </div>
            </div>

            <div id="predefinidasSection" class="mb-3">
                @Html.LabelFor(m => m.ImagenPath, "Seleccionar Imagen", new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(m => m.ImagenPath,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Logo AYA", Value = "/Content/Imagenes/aya.png" },
                        new SelectListItem { Text = "Logo MINAE", Value = "/Content/Imagenes/minae.jpg" },
                        new SelectListItem { Text = "Logo SENARA", Value = "/Content/Imagenes/Logo-nuevo-office-1-300x128.png" }
                    },
                    "Seleccione una imagen...",
                    new { @class = "form-select" })
            </div>

            <div id="personalizadaSection" class="mb-3 d-none">
                @Html.Label("ImagenFile", "Subir Imagen Personalizada", new { @class = "form-label fw-semibold" })
                <input type="file" name="ImagenFile" id="ImagenFile" class="form-control" accept="image/*" />
                <small class="text-muted">Formatos permitidos: JPG, PNG.</small>
            </div>


            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary px-4">Crear Novedad</button>
                <a href="@Url.Action("NovedadesCRUD", "NovedadesAdmin")" class="btn btn-secondary px-4">Cancelar</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            // Selecciona todos los formularios con la clase 'needs-validation'
            const forms = document.querySelectorAll('.needs-validation');
            // Recorre cada formulario para agregar validación personalizada
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    // Si el formulario no es válido, previene el envío
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    // Agrega clase Bootstrap para mostrar visualmente los errores
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        function actualizarOpciones() {
            const predef = document.getElementById("imgPredef");
            const seccionPredef = document.getElementById("predefinidasSection");
            const seccionPers = document.getElementById("personalizadaSection");

            if (predef.checked) {
                seccionPredef.classList.remove("d-none");
                seccionPers.classList.add("d-none");
            } else {
                seccionPredef.classList.add("d-none");
                seccionPers.classList.remove("d-none");
            }
        }

        document.getElementById("imgPredef").addEventListener("change", actualizarOpciones);
        document.getElementById("imgCustom").addEventListener("change", actualizarOpciones);

        // Ejecutar al cargar la página
        actualizarOpciones();
    </script>
}


