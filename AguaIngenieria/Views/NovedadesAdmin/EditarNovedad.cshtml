@model DataModels.Novedade

@{
    ViewBag.Title = "Editar Novedad";
}

<div class="text-center bg-light p-4 rounded shadow-sm mb-4">
    <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo" style="width: 100px; height: auto;" class="mb-3" />
    <h2 class="text-success fw-bold m-0">Editar Novedad</h2>
    <span class="d-block mx-auto" style="width: 120px; height: 3px; background-color: #198754; margin-top: 10px; border-radius: 2px;"></span>
</div>

<div class="d-flex justify-content-center">
    <div class="card shadow-sm p-4" style="min-width:350px; max-width:600px; width:100%;">
        @using (Html.BeginForm("EditarNovedad", "NovedadesAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)

            <div class="mb-3">
                @Html.LabelFor(model => model.Titulo, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Fuente, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Fuente, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Fuente, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Fecha, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(model => model.Fecha, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Resumen, htmlAttributes: new { @class = "form-label" })
                @Html.TextAreaFor(model => model.Resumen, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(model => model.Resumen, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.UrlNoticia, htmlAttributes: new { @class = "form-label" })
                @Html.TextBoxFor(model => model.UrlNoticia, new { @class = "form-control", type = "url" })
                @Html.ValidationMessageFor(model => model.UrlNoticia, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Tipo de Imagen</label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TipoImagen" id="imgPredef" value="predefinida"
                           @(Model.ImagenPath != null && ( Model.ImagenPath.EndsWith("aya.png") || Model.ImagenPath.EndsWith("minae.jpg") || Model.ImagenPath.EndsWith("Logo-nuevo-office-1-300x128.png") ) ? "checked" : "")>
                    <label class="form-check-label" for="imgPredef">Usar imagen predefinida</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TipoImagen" id="imgCustom" value="personalizada"
                           @(Model.ImagenPath != null && !( Model.ImagenPath.EndsWith("aya.png") || Model.ImagenPath.EndsWith("minae.jpg") || Model.ImagenPath.EndsWith("Logo-nuevo-office-1-300x128.png") ) ? "checked" : "")>
                    <label class="form-check-label" for="imgCustom">Subir imagen personalizada</label>
                </div>
            </div>

            <div id="predefinidasSection" class="mb-3">
                @Html.LabelFor(m => m.ImagenPath, "Seleccionar Imagen", new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(m => m.ImagenPath,
                         new List<SelectListItem>
                         {
                        new SelectListItem { Text = "Logo AYA", Value = "~/Content/Imagenes/aya.png", Selected = Model.ImagenPath == "~/Content/Imagenes/AYA.jpg" },
                        new SelectListItem { Text = "Logo MINAE", Value = "~/Content/Imagenes/minae.jpg", Selected = Model.ImagenPath == "~/Content/Imagenes/minae.jpg" },
                        new SelectListItem { Text = "Logo SENARA", Value = "~/Content/Imagenes/Logo-nuevo-office-1-300x128.png", Selected = Model.ImagenPath == "~/Content/Imagenes/Logo-nuevo-office-1-300x128.png" }
                         },
                         "Seleccione una imagen...",
                         new { @class = "form-select" })
            </div>

            <div id="personalizadaSection" class="mb-3 d-none">
                @Html.Label("ImagenFile", "Subir Imagen Personalizada", new { @class = "form-label fw-semibold" })
                <input type="file" name="ImagenFile" id="ImagenFile" class="form-control" accept="image/*" />
                <small class="text-muted">Formatos permitidos: JPG, PNG.</small>
            </div>

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("NovedadesCRUD", "NovedadesAdmin")" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Guardar Cambios
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        function actualizarOpciones() {
            const predef = document.getElementById("imgPredef");
            const seccionPredef = document.getElementById("predefinidasSection");
            const seccionPers = document.getElementById("personalizadaSection");

            if (predef.checked) {
                seccionPredef.classList.remove("d-none");
                seccionPers.classList.add("d-none");
            } else {
                seccionPredef.classList.add("d-none");
                seccionPers.classList.remove("d-none");
            }
        }

        document.getElementById("imgPredef").addEventListener("change", actualizarOpciones);
        document.getElementById("imgCustom").addEventListener("change", actualizarOpciones);

        // Ejecutar al cargar la página
        actualizarOpciones();
    </script>
}