
@{
    ViewBag.Title = "RedesSociales";
}


<link href="@Url.Content("~/CSS/Custom/RedesSociales.css")" rel="stylesheet" />

<div class="redes-container">
    <div class="redes-header">
        <h2>Conéctese con Nosotros</h2>
        <p>Síganos en nuestras redes sociales para conocer nuestros proyectos, servicios y consejos sobre ingeniería y sostenibilidad en Costa Rica.</p>
    </div>

    <div class="redes-content">

        <div class="redes-card instagram">
            <i class="fab fa-instagram"></i>
            <h3>Instagram</h3>
            <p>Descubra nuestros proyectos e historias visuales.</p>
            <a href="https://www.instagram.com/agua_ing_cr/" target="_blank" class="btn-red">Visitar</a>
        </div>

        <div class="redes-card facebook">
            <i class="fab fa-facebook-f"></i>
            <h3>Facebook</h3>
            <p>Conozca más sobre nuestras actividades y servicios.</p>
            <a href="https://www.facebook.com/agua.ingenieria.costa.rica" target="_blank" class="btn-red">Visitar</a>
        </div>

        <div class="redes-card whatsapp">
            <i class="fab fa-whatsapp"></i>
            <h3>WhatsApp</h3>
            <p>Comuníquese con nosotros de forma rápida y directa.</p>
            <a href="https://wa.me/50687618430" target="_blank" class="btn-red">Chatear</a>
        </div>

        <div class="redes-card tiktok">
            <i class="fab fa-tiktok"></i>
            <h3>TikTok</h3>
            <p>Aprenda con tips y contenido técnico breve.</p>
            <a href="@("https://www.tiktok.com/@andrespruebasprog?is_from_webapp=1&sender_device=pc")" target="_blank" class="btn-red">Explorar</a>
        </div>

    </div>
</div>


