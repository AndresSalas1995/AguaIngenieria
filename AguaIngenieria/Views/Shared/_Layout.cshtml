<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Agua Ingenieria Costa Rica</title>
    @Styles.Render("~/Content/css")
    <link href="~/CSS/Custom/Layout.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <div class="d-flex align-items-center">
                <a href="@Url.Action("Index", "Principal")">
                    <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" class="navbar-logo" alt="Logo Empresa" />
                </a>
            </div>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @*Página Principal*@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navPaginaPrincipal" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Página Principal
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navPaginaPrincipal">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Principal")">Inicio</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Novedades", "Principal")">Novedades</a></li>
                        </ul>
                    </li>
                    @*Servicios*@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navServicios" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Servicios
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navServicios">
                            <li><a class="dropdown-item" href="@Url.Action("Servicios", "Servicios")">Servicios</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Concesiones", "Servicios")">Concesiones de Agua</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Estudios", "Servicios")">Estudios y Análisis</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Viabilidad", "Servicios")">Viabilidad y Servicios Técnicos</a></li>
                        </ul>
                    </li>
                    @*Proyectos*@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Proyectos", "Proyectos")">Proyectos</a>
                    </li>

                    @*Contáctenos*@
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navContactenos" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Contáctenos
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navContactenos">
                            <li><a class="dropdown-item" href="@Url.Action("Formulario", "Contacto")">Formulario</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Ubicacion", "Contacto")">Ubicación</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Contacto", "Contacto")">Medios de contacto</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Faqs", "Contacto")">Preguntas Frecuentes</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    @RenderSection("FullWidthContent", required: false)
    <div class="container-fluid body-content">
        @RenderBody()
        <hr />
        <footer class="footer-custom d-flex justify-content-between align-items-center">
            <div class="footer-text">
                Copyright &copy; @DateTime.Now.Year - Agua Ingeniería Costa Rica. Todos los derechos reservados.
            </div>
            <div class="footer-icons">
                <a href="https://www.instagram.com/agua_ing_cr/" target="_blank" aria-label="Instagram">
                    <i class="fab fa-instagram fa-2x"></i>
                </a>
                <a href="https://www.facebook.com/agua.ingenieria.costa.rica" target="_blank" aria-label="Facebook">
                    <i class="fab fa-facebook-f fa-2x"></i>
                </a>
                <a href="https://wa.me/50687618430" target="_blank" aria-label="WhatsApp">
                    <i class="fab fa-whatsapp fa-2x"></i>
                </a>
                <a href="@("https://www.tiktok.com/@andrespruebasprog?is_from_webapp=1&sender_device=pc")" target="_blank" aria-label="TikTok">
                    <i class="fab fa-tiktok fa-2x"></i>
                </a>

            </div>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
