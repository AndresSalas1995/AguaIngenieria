@model DataModels.Galeria

@{
    ViewBag.Title = "EliminarProyecto";
}

<div class="text-center bg-light p-4 rounded shadow-sm mb-4">
    <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo" style="width: 100px; height: auto;" class="mb-3" />
    <h2 class="text-success fw-bold m-0">Eliminar Proyecto</h2>
    <span class="d-block mx-auto" style="width: 120px; height: 3px; background-color: #dc3545; margin-top: 10px; border-radius: 2px;"></span>
</div>

@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h4 class="card-title">@Model.Titulo</h4>
            <img src="@Url.Content(Model.ImagenPath)" alt="Imagen del proyecto" style="max-width: 300px;" class="mb-3" />
            <p><strong>Fecha de subida:</strong> @Model.FechaSubida.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <div class="alert alert-warning text-center">
        <strong>¿Está seguro que desea eliminar este proyecto?</strong>
    </div>

    using (Html.BeginForm("EliminarProyecto", "ProyectosAdmin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a href="@Url.Action("ProyectosCRUD", "ProyectosAdmin")" class="btn btn-secondary ms-2">Cancelar</a>
    }
}
else
{
    <div class="alert alert-danger">
        No se encontró el proyecto.
    </div>
}
