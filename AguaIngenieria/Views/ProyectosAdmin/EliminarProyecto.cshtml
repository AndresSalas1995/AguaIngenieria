@model DataModels.Galeria

@{
    ViewBag.Title = "EliminarProyecto";
}

<div class="d-flex justify-content-center py-5 bg-light" style="min-height: 100vh;">
    <div class="card shadow-lg p-4 rounded" style="max-width: 500px; width: 100%; max-height: 90vh; overflow-y: auto;">

        <div class="text-center p-3 mb-3">
            <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo"
                 style="width: 100px; height: auto;" class="mb-3" />
            <h2 class="text-danger fw-bold m-0">Eliminar Proyecto</h2>
            <span class="d-block mx-auto mt-2" style="width: 120px; height: 3px; background-color: #dc3545; border-radius: 2px;"></span>
        </div>

        @if (Model != null)
        {
            <div class="card mb-4">
                <div class="card-body text-center">
                    <h4 class="card-title">@Model.Titulo</h4>

                    <img src="@Url.Content(Model.ImagenPath)" alt="Imagen del proyecto"
                         style="max-width: 300px; max-height: 200px; border-radius: 6px;"
                         class="mb-3 shadow-sm" />

                    <p><strong>Fecha de subida:</strong> @Model.FechaSubida.ToString("dd/MM/yyyy")</p>
                </div>
            </div>

            <div class="alert alert-warning text-center">
                <strong>¿Está seguro que desea eliminar este proyecto?</strong>
            </div>

            using (Html.BeginForm("EliminarProyecto", "ProyectosAdmin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="text-center">
                    <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                    <a href="@Url.Action("ProyectosCRUD", "ProyectosAdmin")" class="btn btn-secondary px-4 ms-2">Cancelar</a>
                </div>
            }
        }
        else
        {
            <div class="alert alert-danger text-center">
                No se encontró el proyecto.
            </div>
        }
    </div>
</div>

