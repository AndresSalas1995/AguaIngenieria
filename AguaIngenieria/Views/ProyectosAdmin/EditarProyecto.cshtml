@model DataModels.Galeria

@{
    ViewBag.Title = "Editar Proyecto";
}

<div class="d-flex justify-content-center py-5 bg-light" style="min-height: 100vh;">
    <div class="card shadow-lg p-4 rounded" style="max-width: 500px; width: 100%; max-height: 90vh; overflow-y: auto;">

        <div class="text-center p-3 mb-3">
            <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo"
                 style="width: 100px; height: auto;" class="mb-3" />
            <h2 class="text-success fw-bold m-0">Editar Proyecto</h2>
            <span class="d-block mx-auto mt-2" style="width: 120px; height: 3px; background-color: #198754; border-radius: 2px;"></span>
        </div>

        @using (Html.BeginForm("EditarProyecto", "ProyectosAdmin",
               FormMethod.Post,
               new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.ImagenPath)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Titulo, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.Titulo,
                              new { @class = "form-control", placeholder = "Título del proyecto", required = "required" })
                @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="ImagenProyecto">Imagen del proyecto</label>
                <input type="file" name="NuevaImagenProyecto" id="ImagenProyecto"
                       class="form-control" accept="image/*" />
                <span class="text-danger" data-valmsg-for="ImagenProyecto" data-valmsg-replace="true"></span>

                @if (!string.IsNullOrEmpty(Model.ImagenPath))
                {
                    <div class="mt-3 text-center">
                        <img src="@Url.Content(Model.ImagenPath)" alt="Imagen actual"
                             style="max-width: 300px; max-height: 200px; width: auto; height: auto; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                        <small class="text-muted d-block">Imagen actual</small>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success px-4">Guardar Cambios</button>
                <a href="@Url.Action("ProyectosCRUD", "ProyectosAdmin")" class="btn btn-secondary px-4">Cancelar</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}

