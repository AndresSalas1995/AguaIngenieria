@model AguaIngenieria.Models.LoginViewModel

@{
    ViewBag.Title = "Iniciar Sesión";
}

@section FullWidthContent {
    <div class="d-flex align-items-center justify-content-center" style="min-height: 80vh; background: #f0f2f5;">
        <div class="card shadow-lg p-5 rounded-4" style="max-width: 420px; width: 100%; border: none;">
            <div class="text-center mb-4">
                <img src="~/Content/Imagenes/Logo_AguaIngenieria.png" alt="Logo Empresa" style="height: 60px;" class="mb-2" />
                <h4 class="fw-bold">Bienvenido</h4>
                <p class="text-muted">Ingresa tus credenciales para continuar</p>
            </div>

            <form method="post">
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger text-center" })

                <div class="mb-3">
                    <label class="form-label fw-semibold">Usuario o Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white"><i class="fa fa-user"></i></span>
                        @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "Ingrese su usuario o email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white"><i class="fa fa-lock"></i></span>
                        @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", placeholder = "Ingrese su contraseña" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger" })
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg fw-semibold">Iniciar Sesión</button>
                </div>

                <div class="text-center mt-2">
                    @Html.ActionLink("¿Olvidaste tu contraseña?", "Recuperar", "Authentication", new { }, new { @class = "text-decoration-none text-primary" })
                </div>


                @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
                {
                    <div class="alert alert-danger text-center">
                        @ViewBag.Mensaje
                    </div>
                }
            </form>

        </div>
    </div>
}



