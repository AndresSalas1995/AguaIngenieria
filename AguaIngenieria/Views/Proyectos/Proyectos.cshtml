@model IEnumerable<DataModels.Galeria>

@{
    ViewBag.Title = "Proyectos";
}

<link href="~/CSS/Custom/Proyectos.css" rel="stylesheet" />

<div class="container my-5">
    <h2 class="text-center mb-4">Nuestros Proyectos</h2>

    <div class="row">
        @foreach (var proyecto in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@Url.Content(proyecto.ImagenPath)" class="card-img-top" alt="@proyecto.Titulo">
                    <div class="overlay-text">@proyecto.Titulo</div>
                </div>
            </div>
        }
    </div>
</div>



