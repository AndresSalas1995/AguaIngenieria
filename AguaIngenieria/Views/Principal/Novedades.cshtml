@model IEnumerable<DataModels.Novedade>
@{
    ViewBag.Title = "Novedades";
}

@{
    string urlGota = "";

    if (Session["IdUsuario"] != null)
    {
        // Usuario logueado → ir al panel admin
        urlGota = Url.Action("Admin", "Principal");
    }
    else
    {
        // No logueado → ir a autenticación
        urlGota = Url.Action("Index", "Authentication");
    }
}

<link href="@Url.Content("~/CSS/Custom/Novedades.css")" rel="stylesheet" />

<div class="container py-5">
    <div class="novedades-container">
        <h1 class="text-center mb-4 text-primary">
            <i class="fas fa-bullhorn"></i> Últimas Novedades
            <a href="@urlGota" class="ms-2 gota-oculta">
                <img src="@Url.Content("~/Content/Imagenes/gota.jpg")"
                     alt="Login oculto"
                     style="width:32px; height:32px; vertical-align:middle;">
            </a>
        </h1>
    </div>

    <p class="text-center text-muted mb-5">
        Información reciente de instituciones como MINAE, AYA, SENARA, y más.<br />
        Esta sección se actualiza periódicamente para mantenerte informado.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger text-center">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var novedad in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@Url.Content(novedad.ImagenPath)" class="card-img-top" alt="@novedad.Fuente noticia">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="@novedad.UrlNoticia" target="_blank" class="text-decoration-none text-dark">
                                    @novedad.Titulo
                                </a>
                            </h5>
                            <p class="card-subtitle mb-2 text-muted">
                                <i class="fas fa-newspaper"></i> Fuente: @novedad.Fuente | <i class="far fa-calendar-alt"></i> @novedad.Fecha.ToString("dd 'de' MMMM yyyy")
                            </p>
                            <p class="card-text">
                                @novedad.Resumen
                            </p>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <a href="@novedad.UrlNoticia" target="_blank" class="btn btn-outline-primary btn-sm">
                                Leer más <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No hay novedades disponibles en este momento.
        </div>
    }
</div>


