@{
    ViewBag.Title = "Index";
}

@* Seccion de imagenes inicio *@
<link href="@Url.Content("~/CSS/Custom/Principal.css")" rel="stylesheet" />
@section FullWidthContent {
    <div class="slider-container">
        @*<button class="slider-arrow left" id="prevBtn">&#8592;</button>*@
        <button class="slider-arrow left" id="prevBtn" aria-label="Imagen anterior">&#8592;</button>
        <img id="slider" src="@Url.Content("~/Content/Imagenes/ruleta1.jpg")" alt="Slider" />
        <div class="slider-message">
            <div class="line1">Bienvenidos a Agua Ingeniería Costa Rica</div>
            <div class="line2">Ingenieria y Asesoria</div>
            <div class="line3">Gestión en recurso hídrico y ambiente</div>
        </div>
        @*<button class="slider-arrow right" id="nextBtn">&#8594;</button>*@
        <button class="slider-arrow right" id="nextBtn" aria-label="Imagen siguiente">&#8594;</button>
    </div>
}

@* Seccion de presentacion de la empresa *@
<div class="image-text-container">
    <div class="text-content-right">
        <h2>Agua Ingeniería <br /> Costa Rica</h2>
        <p>
            En Agua Ingeniería Costa Rica, somos un equipo de profesionales especializados en el
            manejo técnico, legal y ambiental del recurso hídrico. Nuestra labor se enfoca en
            acompañar a empresas, instituciones públicas y particulares en el cumplimiento de los
            requisitos normativos que exige la legislación costarricense para el desarrollo de
            proyectos sostenibles.
            <br /><br />
            Contamos con amplia experiencia en la gestión de trámites ambientales,
            concesiones de agua, perforación de pozos, estudios hidrogeológicos y asesoría
            técnica integral, ofreciendo soluciones personalizadas que combinan ciencia,
            ingeniería, responsabilidad ambiental, entre otros...
            <br /><br />
            Nuestro compromiso es brindar un servicio confiable, eficiente y ético, respaldado por
            un equipo multidisciplinario con enfoque en la sostenibilidad y la innovación. Cada
            proyecto que realizamos busca no solo cumplir con la normativa, sino también
            contribuir a la protección de los recursos naturales y al desarrollo responsable del país.
            <br /><br />
            <strong>Confíe en nosotros para transformar sus desafíos en soluciones sostenibles.</strong>
            <div class="contact-info">
                <i class="fas fa-envelope"></i><br />
                <strong>Correo electrónico</strong><br />
                <a href="mailto:aguaingenieriacr@gmail.com">aguaingenieriacr@gmail.com</a>
            </div>
        </p>
    </div>
    <div class="image-content">
        <img src="@Url.Content("~/Content/Imagenes/IMG_1724.jpeg")" alt="presentacion" />
    </div>
</div>
<br />
<br />

