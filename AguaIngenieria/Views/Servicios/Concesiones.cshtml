@{
    ViewBag.Title = "Concesiones de Agua";
}

<link href="~/CSS/Custom/Estudios.css" rel="stylesheet" />

<div class="estudios-page">
    @*Hero / Banner*@
    <section class="hero-section">
        <img src="~/Content/Imagenes/banner.png" alt="Concesiones de Agua - Agua Ingeniería Costa Rica" />
        <div class="hero-text">
            <h1>Concesiones de Agua</h1>
            <p>Tramitamos permisos y licencias para el uso legal, responsable y sostenible del recurso hídrico.</p>
        </div>
    </section>

    @*Introducción*@
    <section class="intro-section">
        <h2>Gestión integral de concesiones y permisos hídricos</h2>
        <p>
            En <strong>Agua Ingeniería Costa Rica</strong> acompañamos a nuestros clientes en la obtención de
            concesiones, licencias y permisos requeridos para el uso del recurso hídrico, asegurando el cumplimiento
            de la normativa ambiental y técnica vigente.
        </p>
    </section>

    @*Grid de servicios de concesiones*@
    <section class="estudios-grid">
        <div class="estudio-card" data-info="concesion1">
            <img src="~/Content/Imagenes/AguaNaturaleza.jpg" alt="Aguas superficiales y subterráneas" />
            <h3>Aguas Superficiales y Subterráneas</h3>
            <p>Permisos ante MINAE y SENARA para el aprovechamiento de aguas de ríos, quebradas o pozos.</p>
        </div>

        <div class="estudio-card" data-info="concesion2">
            <img src="~/Content/Imagenes/estudio.jpg" alt="Fuerza hidráulica" />
            <h3>Concesiones de Fuerza Hidráulica</h3>
            <p>Tramitamos concesiones para el aprovechamiento energético de corrientes de agua.</p>
        </div>

        <div class="estudio-card" data-info="concesion3">
            <img src="~/Content/Imagenes/Catarata-Tesoro-Escondido-otra-catarata-que-visitar-en-Costa-Rica.jpg" alt="Permisos de vertido" />
            <h3>Permisos de Vertido</h3>
            <p>Autorizaciones ante el MINAE para el vertido controlado de aguas residuales.</p>
        </div>

        <div class="estudio-card" data-info="concesion4">
            <img src="~/Content/Imagenes/pexels-photo-807598.jpeg" alt="Obras en cauce" />
            <h3>Obras en Cauce</h3>
            <p>Tramitamos permisos y elaboramos estudios técnicos para obras en cauces naturales.</p>
        </div>

        <div class="estudio-card" data-info="concesion5">
            <img src="~/Content/Imagenes/viabilidad.jpg" alt="Obras calibradoras" />
            <h3>Obras Calibradoras</h3>
            <p>Diseño e instalación de obras calibradoras de caudal conforme a disposiciones del MINAE y SENARA.</p>
        </div>
    </section>

    @*Modal informativo*@
    <div id="modal-info" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="modal-body"></div>
        </div>
    </div>

    @*Botón de retorno*@
    <div class="volver-container">
        <a href="@Url.Action("Servicios", "Servicios")" class="volver-btn">Volver a Servicios</a>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(".estudio-card");
        const modal = document.getElementById("modal-info");
        const modalBody = document.getElementById("modal-body");
        const closeBtn = document.querySelector(".close");

        const info = {
            concesion1: {
                title: "Concesiones para Aprovechamiento de Aguas Superficiales y Subterráneas",
                text: "Gestionamos los permisos necesarios ante el MINAE y SENARA para el uso legal del recurso hídrico, ya sea proveniente de ríos, quebradas o pozos. Incluye la elaboración de estudios técnicos y la presentación de documentación conforme a la normativa nacional.",
                img: '@Url.Content("~/Content/Imagenes/AguaNaturaleza.jpg")'
            },
            concesion2: {
                title: "Concesiones de Fuerza Hidráulica",
                text: "Elaboramos estudios y tramitamos concesiones para el aprovechamiento de la energía de corrientes de agua, aplicables a proyectos de tipo Pelton, microcentrales y pequeñas hidroeléctricas.",
                img: '@Url.Content("~/Content/Imagenes/estudio.jpg")'
            },
            concesion3: {
                title: "Permisos de Vertido de Aguas Residuales",
                text: "Realizamos el trámite ante el MINAE para obtener la autorización de vertido de aguas residuales, garantizando el cumplimiento del Reglamento de Vertidos y las normas ambientales vigentes.",
                img: '@Url.Content("~/Content/Imagenes/Catarata-Tesoro-Escondido-otra-catarata-que-visitar-en-Costa-Rica.jpg")'
            },
            concesion4: {
                title: "Obras en Cauce",
                text: "Tramitamos permisos y elaboramos los estudios técnicos requeridos para la ejecución de obras en cauce, como pasos de alcantarilla, puentes, diques o estructuras de contención.",
                img: '@Url.Content("~/Content/Imagenes/pexels-photo-807598.jpeg")'
            },
            concesion5: {
                title: "Diseño e Instalación de Obras Calibradoras",
                text: "Diseñamos e instalamos obras calibradoras de caudal para el aprovechamiento de agua, cumpliendo con las disposiciones del MINAE y SENARA, asegurando una medición precisa del recurso concesionado.",
                img: '@Url.Content("~/Content/Imagenes/viabilidad.jpg")'
            }
        };

        cards.forEach(card => {
            card.addEventListener("click", () => {
                const id = card.getAttribute("data-info");
                const item = info[id];
                modalBody.innerHTML = `
                <h2>${item.title}</h2>
                <img src="${item.img.replace('~', '')}" alt="${item.title}" />
                <p>${item.text}</p>
            `;
                modal.classList.add("show");
            });
        });

        closeBtn.addEventListener("click", () => modal.classList.remove("show"));
        modal.addEventListener("click", e => { if (e.target === modal) modal.classList.remove("show"); });
    });
</script>

