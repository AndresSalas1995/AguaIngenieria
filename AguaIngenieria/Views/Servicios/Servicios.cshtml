@{
    ViewBag.Title = "Servicios";
}

<link href="~/CSS/Custom/Servicios.css" rel="stylesheet" />

<div class="services-page">
    @* imagen de banner *@
    <div class="hero-image">
        <img src="~/Content/Imagenes/banner.png" alt="Servicios Agua Ingeniería Costa Rica" />
    </div>

    @* Titulo *@
    <div class="services-highlight">
        <h2>Nuestros Servicios</h2>
    </div>


    @*introduccion*@
    <section class="services-intro">
        <h1>¿Por qué elegir nuestros servicios?</h1>
        <p>
            En Agua Ingeniería Costa Rica ofrecemos soluciones integrales en concesiones, estudios ambientales y servicios técnicos hídricos.
            Nuestro equipo está compuesto por profesionales altamente capacitados y con experiencia en gestión del recurso hídrico conforme a la legislación vigente.
        </p>
    </section>

    @*Menú de categorías*@
    <section class="services-categories">
        <a href="@Url.Action("Concesiones", "Servicios")" class="category-btn">Concesiones de Agua</a>
        <a href="@Url.Action("Estudios", "Servicios")" class="category-btn">Estudios y Análisis</a>
        <a href="@Url.Action("Viabilidad", "Servicios")" class="category-btn">Viabilidad y Servicios Técnicos</a>
    </section>

    @*Tarjetas de servicios generales (resumen)*@
    <section class="services-grid">
        <div class="service-card">
            <img src="~/Content/Imagenes/concesion.jpg" alt="Concesiones de Agua" class="service-image" />
            <h3>Concesiones de Agua</h3>
            <p>Tramitamos permisos para uso legal del recurso hídrico: aguas superficiales, subterráneas y fuerza hidráulica.</p>
            <a href="@Url.Action("Concesiones", "Servicios")" class="service-btn">Ver más</a>
        </div>

        <div class="service-card">
            <img src="~/Content/Imagenes/estudio.jpg" alt="Estudios y Análisis" class="service-image" />
            <h3>Estudios y Análisis</h3>
            <p>Realizamos estudios hidrogeológicos, análisis de calidad de agua, aforos, y más para cumplir con requisitos del AYA, MINAE y SENARA.</p>
            <a href="@Url.Action("Estudios", "Servicios")" class="service-btn">Ver más</a>
        </div>

        <div class="service-card">
            <img src="~/Content/Imagenes/viabilidad.jpg" alt="Viabilidad y Servicios Técnicos" class="service-image" />
            <h3>Viabilidad y Servicios Técnicos</h3>
            <p>Ofrecemos asesoría técnica y estudios para proyectos en zonas rurales o urbanas, incluyendo perforaciones, bombeos y obras en cauce.</p>
            <a href="@Url.Action("Viabilidad", "Servicios")" class="service-btn">Ver más</a>
        </div>
    </section>
</div>


