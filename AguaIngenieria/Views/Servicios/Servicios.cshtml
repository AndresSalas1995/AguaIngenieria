@{
    ViewBag.Title = "Servicios";
}

<link href="~/CSS/Custom/Servicios.css" rel="stylesheet" />

<div class="services-page">
    @* imagen de banner *@
    <div class="hero-image">
        <img src="~/Content/Imagenes/banner.png" alt="Servicios Agua Ingeniería Costa Rica" />
    </div>

    @* Titulo *@
    <div class="services-highlight">
        <h2>Nuestros Servicios</h2>
    </div>


    @*introduccion*@
    <section class="services-intro">
        <h1>¿Por qué elegir nuestros servicios?</h1>
        <p>
            En <strong>Agua Ingeniería Costa Rica</strong> ofrecemos soluciones integrales en concesiones, estudios ambientales y servicios técnicos hídricos.
            Nuestro equipo está conformado por profesionales especializados en ingeniería, gestión ambiental y recursos hídricos,
            comprometidos con la sostenibilidad y el cumplimiento de la normativa vigente.
        </p>
        <p>
            Nos diferenciamos por brindar un acompañamiento personalizado durante todas las etapas del proceso, desde la consultoría inicial hasta la ejecución técnica,
            garantizando resultados confiables y adaptados a las necesidades de cada cliente.
        </p>

        <ul class="services-benefits">
            <li>Atención personalizada y asesoría profesional.</li>
            <li>Experiencia comprobada en proyectos públicos y privados.</li>
            <li>Cumplimiento estricto de la legislación costarricense.</li>
            <li>Enfoque en sostenibilidad y uso responsable del recurso hídrico.</li>
        </ul>
    </section>


    @*Menú de categorías*@
    <section class="services-categories">
        <a href="@Url.Action("Concesiones", "Servicios")" class="category-btn">Concesiones de Agua</a>
        <a href="@Url.Action("Estudios", "Servicios")" class="category-btn">Estudios y Análisis</a>
        <a href="@Url.Action("Viabilidad", "Servicios")" class="category-btn">Viabilidad y Servicios Técnicos</a>
    </section>

    @*Tarjetas de servicios generales (resumen)*@
    <section class="services-grid">
        <div class="service-card">
            <img src="~/Content/Imagenes/concesion.jpg" alt="Concesiones de Agua" class="service-image" />
            <h3>Concesiones de Agua</h3>
            <p>Tramitamos permisos para uso legal del recurso hídrico: aguas superficiales, subterráneas, fuerza hidráulica, entre otros...</p>
            <a href="@Url.Action("Concesiones", "Servicios")" class="service-btn">Ver más</a>
        </div>

        <div class="service-card">
            <img src="~/Content/Imagenes/estudio.jpg" alt="Estudios y Análisis" class="service-image" />
            <h3>Estudios y Análisis</h3>
            <p>Realizamos estudios hidrogeológicos, análisis de calidad de agua, aforos, y más para cumplir con requisitos del AYA, MINAE, SENARA y más...</p>
            <a href="@Url.Action("Estudios", "Servicios")" class="service-btn">Ver más</a>
        </div>

        <div class="service-card">
            <img src="~/Content/Imagenes/viabilidad.jpg" alt="Viabilidad y Servicios Técnicos" class="service-image" />
            <h3>Viabilidad y Servicios Técnicos</h3>
            <p>Ofrecemos asesoría técnica y estudios para proyectos en zonas rurales o urbanas, incluyendo perforaciones, bombeos, obras en cauce, entre otros...</p>
            <a href="@Url.Action("Viabilidad", "Servicios")" class="service-btn">Ver más</a>
        </div>
    </section>
</div>


